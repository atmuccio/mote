#!/bin/sh
# Mote pre-commit hook: block commits whose *staged* changes add findings that fail the gate.
#
# Install (one repository):
#   cp examples/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or share it through the repository:
#   mkdir -p .githooks && cp examples/hooks/pre-commit .githooks/ && git config core.hooksPath .githooks
#
# Scans the index (what will be committed), compares with HEAD, and prints only new findings.
# Bypass once with `git commit --no-verify`. Set MOTE_HOOK_STRICT=1 to also block when mote
# itself fails (exit 2/3); by default a broken tool never blocks a commit.
set -u

if ! command -v mote >/dev/null 2>&1; then
  echo "mote pre-commit: 'mote' is not on PATH; skipping." >&2
  exit 0
fi

if git rev-parse --verify --quiet HEAD >/dev/null; then
  set -- --base HEAD
else
  set -- # initial commit: nothing to compare with
fi

mote scan --staged --new-only "$@"
rc=$?

case $rc in
  0) exit 0 ;;
  1)
    echo "" >&2
    echo "mote: the quality gate failed for the staged changes (see above)." >&2
    echo "Fix the findings, suppress them with a reason (// mote-ignore[rule]: why)," >&2
    echo "or bypass once with: git commit --no-verify" >&2
    exit 1
    ;;
  *)
    echo "mote pre-commit: mote failed (exit $rc)." >&2
    if [ "${MOTE_HOOK_STRICT:-0}" = 1 ]; then exit "$rc"; fi
    echo "Not blocking the commit (set MOTE_HOOK_STRICT=1 to block)." >&2
    exit 0
    ;;
esac
