function first<T>(items: T[]): T { return items[0]; } // expect: no-unnecessary-type-constraint
function any<T>(x: T) { return x; } // expect: no-unnecessary-type-constraint
const arrow = <T>(x: T) => x; // expect: no-unnecessary-type-constraint
class Box<T, U> {} // expect: no-unnecessary-type-constraint, no-unnecessary-type-constraint
type Alias<T> = T[]; // expect: no-unnecessary-type-constraint
interface Holder<
  T, // expect: no-unnecessary-type-constraint
> { value: T }

// Compliant.
function plain<T>(x: T) { return x; }
function constrained<T extends { id: string }>(x: T) { return x.id; }
function keyed<K extends keyof any>(k: K) { return k; }
function arrays<T extends unknown[]>(x: T) { return x; }
function withDefault<T = unknown>(x: T) { return x; }
type Cond<T> = T extends unknown ? T : never;
